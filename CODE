
// MPU6050 (GY-521) + Local Web Dashboard + NTP (GMT+6) + Buzzer + Telegram Alerts
//
// Required libraries (Arduino IDE -> Library Manager):
//  - MPU6050 (e.g. Jeff Rowberg / i2cdevlib MPU6050)
//  - UniversalTelegramBot
//  - ArduinoJson (for UniversalTelegramBot dependency)
// Note: WiFiClientSecure, Wire, time.h are built-in for ESP32

#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <MPU6050.h>
#include <WiFiClientSecure.h>
#include <UniversalTelegramBot.h>
#include "time.h"
#include <math.h>

// ---------------- CONFIG ----------------
const char* WIFI_SSID = "YOUR_WIFI_NAME";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

const String BOT_TOKEN = "YOUR_TELEGRAM_BOT_TOKEN"; // from BotFather
const String CHAT_ID   = "YOUR_CHAT_ID";           // numeric string like "123456789"

const int BUZZER_PIN = 15;   // buzzer + -> pin, buzzer - -> GND
const int SDA_PIN    = 21;
const int SCL_PIN    = 22;

// detection tuning
const float THRESHOLD_G = 1.8;        // trigger threshold (g). tune for your environment
const int SAMPLE_INTERVAL_MS = 50;    // sensor read interval
const unsigned long ALERT_COOLDOWN_MS = 60UL * 1000UL; // 60s cooldown for Telegram alerts
const unsigned int SIREN_MS = 2500;   // buzzer duration in ms

// NTP / timezone
const char* NTP_SERVER = "pool.ntp.org";
const long  GMT_OFFSET_SEC = 6 * 3600; // Bangladesh UTC+6
const int   DAYLIGHT_OFFSET_SEC = 0;

WebServer server(80);
MPU6050 mpu;
WiFiClientSecure secureClient;
UniversalTelegramBot bot(BOT_TOKEN, secureClient);

volatile unsigned long lastAlertTime = 0;
bool isEventActive = false;

// buzzer control (non-blocking)
unsigned long buzzerOnUntil = 0;

// ---------------- Simple dashboard HTML (served by ESP32) ----------------
const char PAGE_HTML[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Earthquake Detector - Dhaka</title>
<style>
body{font-family:Arial;text-align:center;margin:8px;}
#banner{padding:10px;border-radius:6px;margin:8px auto;display:none;font-weight:bold;}
#chart{border:1px solid #ccc;margin:6px auto;display:block;}
.small{font-size:0.85em;color:#555}
.btn{padding:6px 10px;border-radius:6px;border:1px solid #888;cursor:pointer;background:#f0f0f0}
</style>
</head>
<body>
<h2>🌎 Earthquake Detector Dashboard</h2>
<p class="small">Location: Dhaka, Bangladesh (GMT+6) — Local web dashboard</p>
<div id="banner">⚠️ EARTHQUAKE DETECTED</div>
<canvas id="chart" width="640" height="180"></canvas>
<p><span id="vals">ax:0 ay:0 az:0 total:0.00 g</span></p>
<p><span id="meta">richter:0.00 time:--</span></p>
<p><button class="btn" onclick="testSiren()">Test Siren</button></p>

<script>
// tiny micro chart
class MicroChart {
  constructor(canvas){
    this.c = canvas; this.ctx = canvas.getContext('2d');
    this.dataX=[]; this.dataY=[]; this.dataZ=[];
  }
  push(x,y,z){
    this.dataX.push(x); this.dataY.push(y); this.dataZ.push(z);
    if(this.dataX.length>120){ this.dataX.shift(); this.dataY.shift(); this.dataZ.shift(); }
    this.draw();
  }
  draw(){
    const ctx = this.ctx, w = this.c.width, h = this.c.height;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle = '#eee';
    for(let i=0;i<6;i++){ ctx.beginPath(); ctx.moveTo(0,h/5*i); ctx.lineTo(w,h/5*i); ctx.stroke(); }
    const colors = ['#d9534f','#0275d8','#5cb85c'];
    const sets = [this.dataX,this.dataY,this.dataZ];
    for(let s=0;s<3;s++){
      let arr = sets[s];
      ctx.strokeStyle = colors[s]; ctx.lineWidth = 1.6; ctx.beginPath();
      for(let i=0;i<arr.length;i++){
        let v = arr[i];
        let px = i*(w/120);
        let py = h/2 - (v*45);
        if(i===0) ctx.moveTo(px,py); else ctx.lineTo(px,py);
      }
      ctx.stroke();
    }
  }
}

let chart = new MicroChart(document.getElementById('chart'));
let banner = document.getElementById('banner');
let vals = document.getElementById('vals');
let meta = document.getElementById('meta');

async function update(){
  try {
    const r = await fetch('/data');
    const j = await r.json();
    chart.push(j.ax, j.ay, j.az);
    vals.innerText = `ax:${j.ax.toFixed(2)} ay:${j.ay.toFixed(2)} az:${j.az.toFixed(2)} total:${j.total.toFixed(2)} g`;
    meta.innerText = `richter:${j.richter.toFixed(2)} time:${j.time}`;
    if(j.event){ banner.style.display='block'; banner.style.background='#ffdddd'; } else { banner.style.display='none'; }
  } catch(e){
    // fail silently (e.g., page closed)
  }
}

setInterval(update, 200);

async function testSiren(){
  await fetch('/siren');
}
</script>
</body>
</html>
)rawliteral";

// ---------------- HTTP endpoints ----------------
void handleRoot(){ server.send_P(200, "text/html", PAGE_HTML); }

void handleSiren(){
  // One-shot buzzer test (non-blocking)
  buzzerOnUntil = millis() + 800;
  digitalWrite(BUZZER_PIN, HIGH);
  server.send(200, "text/plain", "siren");
}

void sendSensorData(){
  int16_t ax_r, ay_r, az_r;
  mpu.getAcceleration(&ax_r, &ay_r, &az_r);
  float ax = ax_r / 16384.0;
  float ay = ay_r / 16384.0;
  float az = az_r / 16384.0;
  float total = sqrt(ax*ax + ay*ay + az*az);

  // Richter-like heuristic
  float richter = 0.0;
  if (total > 1.0) richter = log10(1.0 + (total - 1.0) * 100.0);

  // time string (local, GMT+6). configTime used in setup
  time_t now;
  time(&now);
  struct tm timeinfo;
  localtime_r(&now, &timeinfo); // localtime adjusted by configTime
  char timestr[64];
  strftime(timestr, sizeof(timestr), "%Y-%m-%d %H:%M:%S", &timeinfo);

  String json = "{";
  json += "\"ax\":" + String(ax, 2) + ",";
  json += "\"ay\":" + String(ay, 2) + ",";
  json += "\"az\":" + String(az, 2) + ",";
  json += "\"total\":" + String(total, 2) + ",";
  json += "\"richter\":" + String(richter, 2) + ",";
  json += "\"time\":\"" + String(timestr) + "\",";
  json += "\"event\":" + String(isEventActive ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

// ---------------- Telegram ----------------
void sendTelegramAlert(float richter, float total, float ax, float ay, float az, const String &timeStr){
  if (BOT_TOKEN == "" || CHAT_ID == "") return;
  unsigned long now = millis();
  if (now - lastAlertTime < ALERT_COOLDOWN_MS) return; // cooldown

  secureClient.setInsecure(); // avoid cert verification complexity
  String msg = "🌎 *Earthquake Detected!*\\n";
  msg += "*Magnitude:* " + String(richter, 2) + " Richter\\n";
  msg += "*Time:* " + timeStr + " (GMT+6)\\n";
  msg += "*Location:* Dhaka, Bangladesh\\n";
  msg += "*G-Force:* " + String(total, 2) + " g\\n";
  msg += "ax:" + String(ax,2) + " ay:" + String(ay,2) + " az:" + String(az,2);
  bot.sendMessage(CHAT_ID, msg, "Markdown");
  lastAlertTime = now;
}

// ---------------- Setup & Loop ----------------
void setup(){
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  Wire.begin(SDA_PIN, SCL_PIN);
  mpu.initialize();
  if (!mpu.testConnection()) {
    Serial.println("Warning: MPU6050 connection failed! Dashboard will still run for testing.");
  } else {
    Serial.println("MPU6050 OK");
  }

  // Connect WiFi
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to WiFi");
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(300);
    Serial.print(".");
  }
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("\nWiFi connection failed! Dashboard will still work on local AP? (not configured)");
  } else {
    Serial.println("\nConnected! IP: " + WiFi.localIP().toString());
  }

  // NTP / time (set localtime to GMT+6 via offsets)
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER);
  // Wait briefly for time to sync (non-blocking approach: try but continue)
  delay(2000);

  // Start web server
  server.on("/", handleRoot);
  server.on("/data", sendSensorData);
  server.on("/siren", handleSiren);
  server.begin();
  Serial.println("HTTP server started");
}

void loop(){
  server.handleClient();

  // read sensor
  int16_t ax_r, ay_r, az_r;
  mpu.getAcceleration(&ax_r, &ay_r, &az_r);
  float ax = ax_r / 16384.0;
  float ay = ay_r / 16384.0;
  float az = az_r / 16384.0;
  float total = sqrt(ax*ax + ay*ay + az*az);

  // compute Richter-like heuristic
  float richter = 0.0;
  if (total > 1.0) richter = log10(1.0 + (total - 1.0) * 100.0);

  static unsigned long lastDetect = 0;
  if (total > THRESHOLD_G) {
    // event start
    isEventActive = true;
    lastDetect = millis();

    // start non-blocking buzzer
    buzzerOnUntil = millis() + SIREN_MS;
    digitalWrite(BUZZER_PIN, HIGH);

    // get local time string
    time_t now; time(&now);
    struct tm timeinfo; localtime_r(&now, &timeinfo);
    char timestr[64]; strftime(timestr, sizeof(timestr), "%Y-%m-%d %H:%M:%S", &timeinfo);

    // send Telegram alert (rate-limited)
    sendTelegramAlert(richter, total, ax, ay, az, String(timestr));
  } else {
    // decay the eventActive flag after a short time to prevent flicker
    if (isEventActive && millis() - lastDetect > 3000) isEventActive = false;
  }

  // manage buzzer timeout (turn off when time expired)
  if (buzzerOnUntil != 0 && millis() > buzzerOnUntil) {
    digitalWrite(BUZZER_PIN, LOW);
    buzzerOnUntil = 0;
  }

  delay(SAMPLE_INTERVAL_MS);
}
